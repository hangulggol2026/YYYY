---
interface Props {
  variant: 'onDark' | 'onLight';
}

const { variant } = Astro.props;
const base = import.meta.env.BASE_URL;
const src =
  variant === 'onDark'
    ? `${base}assets/header_white.svg`
    : `${base}assets/header_black.svg`;
---

<header class="site-header">
  <img
    src={src}
    alt="옆의 옆의 옆의 옆에"
    width={variant === 'onDark' ? 1157 : 887}
    height={variant === 'onDark' ? 200 : 153}
  />
</header>

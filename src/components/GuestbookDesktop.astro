---
import DesktopCreditsBlock from './DesktopCreditsBlock.astro';
import DesktopPartnerLogos from './DesktopPartnerLogos.astro';
import fontsData from '../../data/fonts.json';

const base = import.meta.env.BASE_URL;
---

<div class="guestbook-desktop" data-guestbook-desktop>
  <div class="guestbook-desktop-viewport">
    <div class="guestbook-desktop-scaler">
      <div class="guestbook-desktop__canvas">
        <div class="guestbook-desktop__partition" data-guestbook-desktop-partition aria-hidden="true"></div>
        <aside class="guestbook-desktop__left" aria-label="전시 서체 및 크레딧">
          <div class="main-desktop__header guestbook-desktop__header">
            <img
              src={`${base}assets/header_white.svg`}
              alt="옆의 옆의 옆의 옆에"
              width="560"
              height="96"
              decoding="async"
            />
          </div>
          <div class="guestbook-desktop__rule" aria-hidden="true"></div>
          <nav class="guestbook-desktop__fonts" aria-label="전시 서체">
            {
              fontsData.fonts.map((font) => (
                <button
                  type="button"
                  class="guestbook-desktop__font-cell"
                  data-guestbook-desktop-font
                  data-font-id={font.id}
                  data-font-name={font.name}
                >
                  <span class="guestbook-desktop__font-stack">
                    <span class="guestbook-desktop__font-label specimen-text">{font.name}</span>
                    <span class="guestbook-desktop__font-rule" aria-hidden="true"></span>
                  </span>
                </button>
              ))
            }
          </nav>
          <div class="guestbook-desktop__rule guestbook-desktop__rule--lower" aria-hidden="true"></div>
          <DesktopCreditsBlock />
          <DesktopPartnerLogos base={base} variant="main-left" />
        </aside>
        <div class="guestbook-desktop__right" data-guestbook-desktop-right>
          <div class="guestbook-desktop__entries" data-guestbook-desktop-entries aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>
</div>

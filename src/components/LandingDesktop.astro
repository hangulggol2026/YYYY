---
import exhibition from '../../data/exhibition.json';
import DesktopCreditsBlock from './DesktopCreditsBlock.astro';
import DesktopPartnerLogos from './DesktopPartnerLogos.astro';

interface Props {
  base: string;
}

const { base } = Astro.props;

type ExhibitionCopy = typeof exhibition & {
  desktopMastLines?: string[];
  desktopIntroLines?: string[];
};

const copy = exhibition as ExhibitionCopy;
const mastLines =
  copy.desktopMastLines ?? ['한글꼴연구회 가을전 ', '《옆의 옆의 옆의 옆에》'];
const introLines =
  copy.desktopIntroLines ??
  (exhibition as { introLines?: string[] }).introLines ??
  exhibition.introParagraphs;
---

<div
  class="landing-desktop-viewport"
  data-landing-desktop-interaction
  role="button"
  tabindex="0"
  aria-label="전시 목록으로 열기"
>
  <div class="landing-desktop-scaler">
    <div class="landing-desktop__canvas" data-landing-desktop>
      <div class="landing-desktop__panel landing-desktop__panel--left" data-landing-desktop-left>
        <p class="landing-desktop__mast">
          {mastLines.map((line) => (
            <span class="landing-desktop__mast-line">{line}</span>
          ))}
        </p>
        <DesktopCreditsBlock />
      </div>

      <div
        class="landing-desktop__partition"
        data-landing-desktop-partition
        aria-hidden="true"
      ></div>

      <div class="landing-desktop__panel landing-desktop__panel--right" data-landing-desktop-right>
        <div class="landing-desktop__right-slot">
          <img
            class="landing-desktop__wordmark"
            src={`${base}assets/header_white.svg`}
            alt="옆의 옆의 옆의 옆에"
            width="1165"
            height="200"
            decoding="async"
          />
          <div class="landing-desktop__intro">
            {introLines.map((line) => (
              <p class="landing-desktop__intro-line">{line}</p>
            ))}
          </div>
          <DesktopPartnerLogos base={base} variant="landing-right" />
        </div>
      </div>
    </div>
  </div>
</div>

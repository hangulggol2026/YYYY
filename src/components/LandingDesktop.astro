---
import exhibition from '../../data/exhibition.json';

interface Props {
  base: string;
}

const { base } = Astro.props;
const introLines =
  (exhibition as { introLines?: string[] }).introLines ?? exhibition.introParagraphs;
const participantLines =
  (exhibition as { participantLines?: string[] }).participantLines ??
  [exhibition.participants.join(' ')];
const introText = introLines.join('\n');
---

<div
  class="landing-desktop-viewport"
  data-landing-desktop-interaction
  role="button"
  tabindex="0"
  aria-label="전시 목록으로 열기"
>
  <div class="landing-desktop-scaler">
    <div class="landing-desktop__canvas" data-landing-desktop>
      <div class="landing-desktop__panel landing-desktop__panel--left" data-landing-desktop-left>
        <p class="landing-desktop__mast">
          한글꼴연구회 가을전
          <br />
          《옆의 옆의 옆의 옆에》
        </p>
        <p class="landing-desktop__intro">{introText}</p>
      </div>

      <div
        class="landing-desktop__partition"
        data-landing-desktop-partition
        aria-hidden="true"
      ></div>

      <div class="landing-desktop__panel landing-desktop__panel--right" data-landing-desktop-right>
        <div class="landing-desktop__right-slot">
        <img
          class="landing-desktop__wordmark"
          src={`${base}assets/header_white.svg`}
          alt="옆의 옆의 옆의 옆에"
          width="1165"
          height="200"
          decoding="async"
        />
        <span class="landing-desktop__label landing-desktop__label--1">참여</span>
        {
          participantLines.map((line, i) => (
            <span class={`landing-desktop__value landing-desktop__value--p${i + 1}`}>{line}</span>
          ))
        }
        <span class="landing-desktop__label landing-desktop__label--2">협업</span>
        <span class="landing-desktop__value landing-desktop__value--collab">{exhibition.collaboration}</span>
        <span class="landing-desktop__label landing-desktop__label--3">웹</span>
        <span class="landing-desktop__value landing-desktop__value--web">{exhibition.web}</span>
        <img
          class="landing-desktop__logo landing-desktop__logo--agti"
          src={`${base}assets/AGTI.svg`}
          alt="AGTI"
          width="54"
          height="20"
          decoding="async"
        />
        <img
          class="landing-desktop__logo landing-desktop__logo--hangul"
          src={`${base}assets/hangulggol_white.svg`}
          alt="한글꼴연구회"
          width="48"
          height="19"
          decoding="async"
        />
        </div>
      </div>
    </div>
  </div>
</div>

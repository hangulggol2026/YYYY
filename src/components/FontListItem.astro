---
import type { FontEntry } from '../lib/types';
import { maniculeImagePath } from '../lib/manicules';

interface Props {
  font: FontEntry;
  previewPhrase: string;
}

const { font, previewPhrase } = Astro.props;
const base = import.meta.env.BASE_URL;
// Enough repeats that the track stays full while it scrolls exactly one copy (1/N) per cycle.
const MARQUEE_COPIES = 8;
const maniculeRel = maniculeImagePath(font.id);
const maniculeSrc = maniculeRel ? `${base}${maniculeRel}` : null;
---

<article class="font-list-item" data-font-id={font.id}>
  <a href={`${base}fonts/${font.id}`} class="font-list-item__link">
    <p class="font-list-item__meta">
      <span class="font-list-item__name">{font.name}</span>
      {
        maniculeSrc ? (
          <span class="font-list-item__manicule" aria-hidden="true">
            <img class="font-list-item__manicule-img" src={maniculeSrc} alt="" loading="lazy" decoding="async" />
          </span>
        ) : (
          <span class="sep" aria-hidden="true">
            {' '}
            ☞{' '}
          </span>
        )
      }
      <span class="font-list-item__designer">{font.designer}</span>
    </p>
    <div class="font-list-item__carousel" aria-label={previewPhrase}>
      <div class="font-list-item__carousel-track" style={`--marquee-copies: ${MARQUEE_COPIES}`}>
        {
          Array.from({ length: MARQUEE_COPIES }, (_, i) => (
            <span class="font-list-item__preview specimen-text" aria-hidden={i === 0 ? undefined : 'true'}>
              {previewPhrase}
            </span>
          ))
        }
      </div>
    </div>
  </a>
  <hr class="font-list-item__rule" />
</article>

<style>
  .font-list-item__link {
    display: block;
    cursor: pointer;
  }
  .font-list-item__link:active {
    opacity: 0.7;
  }
</style>

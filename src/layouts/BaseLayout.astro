---
import '../styles/global.css';
import GuestbookOverlay from '../components/GuestbookOverlay.astro';
import SiteMeta from '../components/SiteMeta.astro';
import { exhibitionFontFaceCss } from '../lib/exhibition-fonts';

interface Props {
  title?: string;
  bodyClass?: string;
  description?: string;
}

const {
  title = '옆의 옆의 옆의 옆에',
  bodyClass = '',
  description,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <SiteMeta title={title} description={description} />
    <title>{title}</title>
    <style is:global set:html={exhibitionFontFaceCss(base)} />
    <script is:inline>
      (function () {
        var FRAME_W = 1277;
        var FRAME_H = 2776;
        var WEB_FRAME_W = 1920;
        var DL_W = 1920;
        var DL_H = 1200;
        var isDesktopLayout = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        var vv = window.visualViewport;
        var w = vv ? vv.width : window.innerWidth;
        var h = vv ? vv.height : window.innerHeight;
        var top = vv ? vv.offsetTop : 0;
        var left = vv ? vv.offsetLeft : 0;
        var scaleW = w / FRAME_W;
        var scaleH = h / FRAME_H;
        var landingScale = w <= FRAME_W ? scaleW : Math.min(scaleW, scaleH);
        var exhibitionW = isDesktopLayout ? WEB_FRAME_W : FRAME_W;
        var root = document.documentElement;
        root.style.setProperty('--vb', Math.min(w, exhibitionW) + 'px');
        root.style.setProperty('--vbh', Math.min(h, FRAME_H) + 'px');
        root.style.setProperty('--landing-scale', String(landingScale));
        root.style.setProperty('--vv-width', w + 'px');
        root.style.setProperty('--vv-height', h + 'px');
        root.style.setProperty('--vv-top', top + 'px');
        root.style.setProperty('--vv-left', left + 'px');
        root.dataset.landingFit = w <= FRAME_W ? 'width-scroll' : 'contain';
        root.dataset.exhibitionFit = w <= FRAME_W ? 'width' : 'contain';
        root.dataset.viewport = isDesktopLayout ? 'web' : 'mobile';
        var dlScale = isDesktopLayout ? Math.min(w / DL_W, h / DL_H) : 1;
        root.style.setProperty('--desktop-landing-scale', String(dlScale));
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
    <GuestbookOverlay />
    <script src="../scripts/font-ready.ts"></script>
    <script src="../scripts/viewport-scale.ts"></script>
    <script src="../scripts/desktop-nav.ts"></script>
    <script src="../scripts/guestbook.ts"></script>
    <script src="../scripts/grid-debug.ts"></script>
  </body>
</html>

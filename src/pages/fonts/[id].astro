---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuestbookSticky from '../../components/GuestbookSticky.astro';
import LayoutGrid from '../../components/LayoutGrid.astro';
import DetailDesktop from '../../components/DetailDesktop.astro';
import DetailTypoControls from '../../components/DetailTypoControls.astro';
import fontsData from '../../../data/fonts.json';
import exhibition from '../../../data/exhibition.json';

export function getStaticPaths() {
  return fontsData.fonts.map((font) => ({
    params: { id: font.id },
    props: { font },
  }));
}

const { font } = Astro.props;
const specimenDefault = exhibition.defaultSpecimenText;
const leadingMin = 130;
const defaultLeading = font.specimenLeading ?? 185;
/** Default sits at the center of the leading slider track (symmetric min/max). */
const leadingMax = defaultLeading + (defaultLeading - leadingMin);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`${font.name} | ${exhibition.title}`}
  description={`${font.name} — ${font.designer}`}
  bodyClass={`page-detail page-font-${font.id}`}
>
  <DetailDesktop
    base={base}
    font={font}
    specimenDefault={specimenDefault}
    leadingMin={leadingMin}
    leadingMax={leadingMax}
    defaultLeading={defaultLeading}
  />

  <div class="detail-page detail-page--mobile">
    <LayoutGrid bleed dark class="detail-hero">
      <div class="span-8 detail-hero__top">
        <a data-href={`${base}?enter=main`} role="link" tabindex="0" class="detail-back" aria-label="목록으로">
          <span class="detail-back__chevron" aria-hidden="true"></span>
        </a>
        <div class="detail-hero__headline">
          <h1 class="detail-hero__title">{font.name}</h1>
          <span class="detail-hero__byline">
            <span class="detail-hero__designer">{font.designer}</span>{' '}
            <a
              class="detail-hero__instagram"
              href={`https://www.instagram.com/${font.instagram}/`}
              target="_blank"
              rel="noopener noreferrer"
            >
              @{font.instagram}
            </a>
          </span>
          <p class="detail-hero__caption">{font.caption}</p>
        </div>
      </div>
    </LayoutGrid>

    <LayoutGrid light class="detail-controls">
      <div class="span-8">
        <DetailTypoControls
          base={base}
          defaultLeading={defaultLeading}
          leadingMin={leadingMin}
          leadingMax={leadingMax}
          showWeights={font.id === 'seopung'}
          idPrefix="mobile"
        />
      </div>
    </LayoutGrid>

    <LayoutGrid light class="detail-specimen">
      <div
        class="span-8 detail-specimen__surface"
        data-specimen-scope
        style={`--specimen-leading-base: ${defaultLeading / 100}`}
      >
        <textarea
          class="specimen-text"
          data-specimen-input
          data-specimen-default={specimenDefault}
          data-font-id={font.id}
          data-font-name={font.name}
          rows="8"
          autocomplete="off"
          autocapitalize="sentences"
          spellcheck="true"
          aria-label="서체 견본 입력"
        >{specimenDefault}</textarea
        >
      </div>
    </LayoutGrid>
  </div>

  <GuestbookSticky />
  <script src="../../scripts/specimen-controls.ts"></script>
  <script src="../../scripts/detail-desktop-layout.ts"></script>
</BaseLayout>

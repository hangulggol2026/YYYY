---
import BaseLayout from '../layouts/BaseLayout.astro';
import MainView from '../components/MainView.astro';
import exhibition from '../../data/exhibition.json';

const introLines =
  (exhibition as { introLines?: string[] }).introLines ?? exhibition.introParagraphs;
const participantLines =
  (exhibition as { participantLines?: string[] }).participantLines ??
  [exhibition.participants.join(' ')];
---

<BaseLayout title={`${exhibition.title} | 한글꼴 가을전`} bodyClass="page-landing">
  <div id="partition-root" class="partition-stage" data-partition-root>
    <div class="partition-main" data-partition-main aria-hidden="true">
      <div class="main-scaled-wrap">
        <MainView />
      </div>
    </div>

    <div class="landing-viewport" data-landing-viewport>
      <div class="landing-canvas-scaler">
      <div
        class="landing-canvas bg-dark"
        data-partition-overlay
        data-landing-interaction
        role="button"
        tabindex="0"
        aria-label="전시 목록으로 열기"
      >
        <div class="landing-top">
          <div class="landing-canvas__header">
            <img
              src="/assets/header_white.svg"
              alt="옆의 옆의 옆의 옆에"
              width="1157"
              height="200"
              decoding="async"
            />
          </div>
          <div class="landing-canvas__intro">
            {
              introLines.map((line, index) => (
                <>
                  {index > 0 && <br />}
                  {line}
                </>
              ))
            }
          </div>
        </div>

        <div class="landing-canvas__partition" data-landing-partition>
          <div class="partition-white-fill" aria-hidden="true"></div>
          <span class="partition-open-zone__bar" aria-hidden="true">
            <span class="partition-open-zone__seam partition-open-zone__seam--top"></span>
            <span class="partition-open-zone__seam partition-open-zone__seam--bottom"></span>
          </span>
        </div>

        <div class="landing-bottom">
          <p class="landing-credits__title">{exhibition.creditsTitle}</p>
          <dl class="landing-credits__list">
            <dt class="landing-credits__label landing-credits__label--participants">참여</dt>
            {
              participantLines.map((line, index) => (
                <dd class={`landing-credits__value landing-credits__participants-line landing-credits__participants-line--${index + 1}`}>
                  {line}
                </dd>
              ))
            }
            <dt class="landing-credits__label landing-credits__label--collab">협업</dt>
            <dd class="landing-credits__value landing-credits__value--collab">{exhibition.collaboration}</dd>
            <dt class="landing-credits__label landing-credits__label--web">웹</dt>
            <dd class="landing-credits__value landing-credits__value--web">{exhibition.web}</dd>
          </dl>
          <div class="landing-logos">
            <img src="/assets/AGTI.svg" alt="AGTI" class="landing-logos__agti" />
            <img src="/assets/hangulggol_white.svg" alt="한글꼴연구회" class="landing-logos__hangul" />
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>

  <script src="../scripts/landing-fit.ts"></script>
  <script src="../scripts/partition-reveal.ts"></script>
</BaseLayout>

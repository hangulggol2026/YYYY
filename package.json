{
  "name": "hangulggol-autumn-2026",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host --open",
    "start": "npm run dev",
    "open": "open http://localhost:4321/dev.html",
    "open:main": "open http://localhost:4321/main",
    "open:seopung": "open http://localhost:4321/fonts/seopung",
    "build": "astro build",
    "preview": "astro preview --host --open",
    "fonts:woff2": ".venv-fonts/bin/python -c \"import cffsubr\" 2>/dev/null || .venv-fonts/bin/pip install -q cffsubr; .venv-fonts/bin/python scripts/convert-fonts-woff2.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "astro": "^5.7.0"
  },
  "devDependencies": {
    "playwright": "^1.50.1"
  }
}
